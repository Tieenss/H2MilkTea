# Supabase Configuration (STAGING ONLY)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-STAGING-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-STAGING-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Safety Guardrail: Project Ref của production (chặn tuyệt đối scripts/dev kết nối nhầm)
# Ví dụ: FORBIDDEN_SUPABASE_REFS=abcdefghijklmnopqrst,xyzuvw123456
FORBIDDEN_SUPABASE_REFS=

# NextAuth (Authentication)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (Upload ảnh)
NEXT_PUBLIC_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_UPLOAD_PRESET=your_upload_preset

# Payment & Printer
PAYMENT_API_KEY=your_payment_api_key
PRINT_SERVICE_URL=http://localhost:8080

# Google Drive API
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=your_google_drive_api_key
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id

# Gemini AI (STAGING / dev - dùng quota riêng)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Feature Flags (Mặc định tắt trên production, bật theo từng phase)
FEATURE_AI_V2=false
FEATURE_QR_TOKEN=false
FEATURE_SMART_SYNC=false
